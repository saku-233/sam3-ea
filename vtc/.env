# ==========================================
# 1. 在地端開發環境設定 (Local Database)
# ==========================================
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=123
DB_NAME=vtc_db
DB_PORT=3306

# ==========================================
# 2. AWS 雲端服務設定 (AWS Credentials)
# ==========================================
AWS_ACCESS_KEY_ID=你的AWS用戶公鑰(AKIA...)
AWS_SECRET_ACCESS_KEY=你的AWS用戶私鑰(SecretKey)
AWS_REGION=ap-east-1                  # 例如香港區域是 ap-east-1
AWS_S3_BUCKET=你的S3儲存桶名稱         # 如果有用到 S3 圖片儲存